# =====================================================================
# NovaTech RAG Assistant - Git Ignore Rules
# =====================================================================

# Environment variables & secrets (CRITICAL: Never commit API keys)
.env
*.env
!.env.example

# Virtual environments
adityaenv/
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local Vector Store (automatically generated on first run)
vector_store/*
!vector_store/.gitkeep

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
