# =====================================================================
# NovaTech RAG Assistant - Environment Configuration Template
# Copy this file to .env and fill in your API keys and preferred settings.
# =====================================================================

# --- API Keys ---
# Provide at least one API key corresponding to your chosen LLM_PROVIDER
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Provider Selection ---
# Options: "openai" or "gemini"
LLM_PROVIDER=openai

# --- Model Selection ---
# Chat / Generation Models
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash

# Embedding Models
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --- RAG Hyperparameters ---
# Creativity / Randomness (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.2

# Number of top candidate chunks to retrieve from vector store
TOP_K=5

# Minimum cosine similarity threshold for retrieved context (0.0 to 1.0)
# Note: Useful thresholds vary by embedding model. Recommended: 0.30 - 0.40
SIMILARITY_THRESHOLD=0.35

# Chunking Configuration (characters)
CHUNK_SIZE=900
CHUNK_OVERLAP=150
